bench-trin:
	@echo "Running Trin Bench"
	@./run-bench.sh trin put
	@echo "Down running Trin Bench"

bench-trin-get:
	@echo "Running Trin Bench"
	@./run-bench.sh trin get
	@echo "Down running Trin Bench"

bench-trin-perf:
	@echo "Running Trin Bench"
	@./run-bench.sh trin perf
	@echo "Down running Trin Bench"	

clean:
	sudo rm -r logs
